{
  "name": "chat-overlay",
  "version": "1.0.1",
  "private": true,
  "description": "Transparent always-on-top chat overlay for GoodGame.ru and Twitch",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
